<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Email Verification</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        font-family: Arial, Helvetica, sans-serif;
      }

      .container {
        width: 100%;
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      .header {
        background: #7d52f4;
        padding: 40px 20px;
        text-align: center;
        color: #ffffff;
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
      }

      .content {
        padding: 40px 30px;
        color: #333333;
        font-size: 16px;
        line-height: 24px;
      }

      .otp-box {
        background: #f7f7f7;
        border: 2px dashed #7d52f4;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        margin: 30px 0;
      }

      .otp-code {
        font-size: 36px;
        font-weight: bold;
        letter-spacing: 8px;
        color: #7d52f4;
        margin: 10px 0;
        font-family: 'Courier New', monospace;
      }

      .footer {
        background: #f7f7f7;
        text-align: center;
        padding: 20px;
        font-size: 14px;
        color: #666666;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- HEADER -->
      <div class="header">
        <h1>Verify Your Email</h1>
      </div>

      <!-- BODY -->
      <div class="content">
        <p>Hi {{ userName }},</p>

        <p>
          Thank you for signing up! Please verify your email address by entering
          the verification code below in your application.
        </p>

        <div class="otp-box">
          <p style="margin: 0; font-size: 14px; color: #666;">Your verification code is:</p>
          <div class="otp-code">{{ otp }}</div>
          <p style="margin: 10px 0 0 0; font-size: 12px; color: #999;">
            Enter this code to verify your email
          </p>
        </div>

        <p style="color: #666; font-size: 14px;">
          This code will expire in {{ expirationMinutes }} minutes.
        </p>

        <p style="color: #999; font-size: 13px; margin-top: 30px;">
          <strong>Security tip:</strong> Never share this code with anyone. Rea will never ask you for this code.
        </p>

        <p>
          Best regards,<br />
          The Rea Team
        </p>
      </div>

      <!-- FOOTER -->
      <div class="footer">
        If you didn't sign up for Rea, you can safely ignore this email.
        <br /><br />
        © {{ copyRightYear }} Rea
      </div>
    </div>
  </body>
</html>