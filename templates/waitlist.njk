                      fill="#7D52F4"
                      fill-opacity="0.1"
                    />
                  </svg>

                  <svg
                    class="ellipse-three"
                    width="56"
                    height="56"
                    viewBox="0 0 56 56"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M55.7145 -0.142757C55.7145 30.7063 30.7063 55.7145 -0.142757 55.7145C-30.9919 55.7145 -56 30.7063 -56 -0.142757C-56 -30.9919 -30.9919 -56 -0.142757 -56C30.7063 -56 55.7145 -30.9919 55.7145 -0.142757ZM-46.2123 -0.142757C-46.2123 25.3007 -25.5862 45.9267 -0.142757 45.9267C25.3007 45.9267 45.9267 25.3007 45.9267 -0.142757C45.9267 -25.5862 25.3007 -46.2123 -0.142757 -46.2123C-25.5862 -46.2123 -46.2123 -25.5862 -46.2123 -0.142757Z"
                      fill="#7D52F4"
                      fill-opacity="0.1"
                    />
                  </svg>
                </div>

                <!-- CONTENT -->
                <div class="content">
                  <p class="greeting">Hi {{ name }},</p>
                  <p class="main-text">
                    Thank you for joining the waitlist for Rea.
                  </p>

                  <div class="highlight-box">
                    <p class="highlight-text">
                      We're exploring a simple idea:<br />
                      What if the Bible could talk back?
                    </p>
                  </div>

                  <p class="body-text">
                    Rea is being built to help you reflect, ask questions, and
                    grow closer to God through gentle, Scripture-filled
                    conversations. We'll keep you updated as we get closer to
                    launch, and you'll be among the first to experience it.
                  </p>

                  <p class="body-text">
                    Thank you for being part of this journey with us.<br />
                    We can't wait to share more with you soon.
                  </p>

                  <div class="signature">
                    <p>With gratitude,</p>
                    <p>The Rea Team.</p>
                  </div>
                </div>

                <!-- FOOTER -->
                <div class="footer">
                  <p class="unsubscribe">
                    If you ever wish to step off this journey, you can
                    <a href="{{ unsubscribeUrl }}" class="link">unsubscribe</a>
                    anytime.
                  </p>
                  <p class="copyright">© {{ copyRightYear }} Rea</p>
                </div>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </body>
</html>
