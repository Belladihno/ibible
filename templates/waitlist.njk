<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Welcome to Rea</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f5f5f5;
      }

      .email-wrapper {
        width: 100%;
        padding: 20px;
        box-sizing: border-box;
      }

      .container {
        width: 90%;
        max-width: 600px;
        color: #5c5c5c;
        margin: 0 auto;
        background-color: #ffffff;
      }

      .header {
        height: 144px;
        background-color: #7d52f41a;
        display: flex;
        flex-direction: column;
        position: relative;
        justify-content: flex-end;
        padding: 0;
      }

      .logo {
        width: 70px;
        height: 44px;
        margin: 20px;
        display: block;
      }

      .ellipse-one {
        width: 230px;
        height: 50px;
        position: absolute;
        right: 0;
        bottom: 0;
      }

      .ellipse-two {
        width: 111px;
        height: 60px;
        position: absolute;
        top: 0;
        left: 0;
      }

      .ellipse-three {
        width: 170px;
        height: 60px;
        position: absolute;
        top: 0;
        right: 50px;
      }

      .content {
        padding: 20px;
        color: #333333;
        line-height: 1.6;
      }

      .greeting {
        font-size: 16px;
        margin-bottom: 8px;
        color: #333333;
      }

      .main-text {
        font-size: 16px;
        margin-bottom: 24px;
        color: #333333;
      }

      .highlight-box {
        background-color: #7d52f41a;
        border-left: 4px solid #7d52f4;
        color: #7d52f4;
        padding: 20px;
        margin: 24px 0;
      }

      .highlight-text {
        font-size: 16px;
        color: #6b4de6;
        margin: 0;
        line-height: 1.5;
      }

      .body-text {
        font-size: 15px;
        color: #555555;
        line-height: 1.7;
        margin-bottom: 16px;
      }

      .signature {
        font-size: 15px;
        color: #333333;
        margin-top: 24px;
      }

      .signature p {
        margin: 0;
      }

      .signature p + p {
        margin-top: 4px;
      }

      .footer {
        padding: 30px 40px;
        text-align: center;
        background-color: #f7f7f7;
      }

      .unsubscribe {
        font-size: 13px;
        color: #999999;
        margin-bottom: 12px;
      }

      .link {
        color: #999999;
        text-decoration: underline;
      }

      .copyright {
        font-size: 13px;
        color: #bbbbbb;
        margin: 0;
      }

      /* Responsive design */
      @media screen and (max-width: 600px) {
        .container {
          width: 100%;
        }

        .ellipse-one,
        .ellipse-two,
        .ellipse-three {
          display: none;
        }

        .content {
          padding: 15px;
        }

        .footer {
          padding: 20px 15px;
        }
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        style="max-width: 600px; margin: 0 auto"
      >
        <tbody>
          <tr>
            <td>
              <div class="container">
                <!-- HEADER -->
                <div class="header">
                  <svg
                    class="logo"
                    width="54"
                    height="19"
                    viewBox="0 0 54 19"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M0 18.612V17.892H2.448V1.332H0V0.612001C1.224 0.612001 4.392 0.612001 6.408 0H6.768V3.276L7.236 2.88C8.46 1.836 10.656 0.215999 13.248 0.215999C17.964 0.215999 17.856 4.932 14.832 4.932C12.312 4.932 13.212 1.656 11.052 1.62C9.648 1.62 7.632 3.492 6.768 4.212V17.892H9.216V18.612H0Z"
                      fill="#7D52F4"
                    />
                    <path
                      d="M33.507 13.068L33.903 13.248C32.571 16.956 29.007 18.972 25.911 18.972C14.895 18.972 14.283 0.251999 26.163 0.251999C30.123 0.251999 33.795 1.872 33.831 5.472H21.627C20.799 9.828 23.175 15.768 28.863 15.768C30.699 15.768 32.463 14.868 33.507 13.068ZM21.807 4.752H29.727C29.547 2.556 28.719 0.972 26.199 0.972C23.895 0.972 22.419 2.592 21.807 4.752Z"
                      fill="#7D52F4"
                    />
                    <path
                      d="M34.9664 14.364C34.9664 7.344 46.4864 11.736 46.4864 5.184C46.4864 2.412 44.7584 1.332 43.2824 1.332C42.0224 1.332 40.5824 1.872 40.5824 3.348C40.5824 4.068 41.1584 4.68 41.1584 5.508C41.1584 6.84 40.2224 7.452 39.2144 7.452C38.1704 7.452 37.0904 6.768 37.0904 5.4C37.0904 2.556 41.8784 0.251999 45.1184 0.251999C48.3944 0.251999 50.8784 1.656 50.9144 5.112C50.9504 9.576 46.8104 9.36 43.6784 9.756C41.3024 10.044 39.2504 10.404 39.2504 12.744C39.2504 14.508 40.2944 15.696 42.1664 15.696C46.4504 15.66 47.2064 12.528 49.6544 12.528C50.2664 12.528 50.8064 12.744 50.8064 13.464V15.12C50.8064 16.668 50.8064 17.892 52.4264 17.892H53.1464V18.612C52.3544 18.684 50.5544 18.72 49.7624 18.72C47.1704 18.72 46.5584 17.892 46.4864 15.012C44.7584 16.236 42.8504 19.008 39.7184 19.008C36.9824 19.008 34.9664 17.1 34.9664 14.364Z"
                      fill="#7D52F4"
                    />
                  </svg>

                  <svg
                    class="ellipse-one"
                    width="201"
                    height="51"
                    viewBox="0 0 201 51"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle
                      cx="100.233"
                      cy="-49.3091"
                      r="100.209"
                      transform="rotate(14.1701 100.233 -49.3091)"
                      fill="#7D52F4"
                      fill-opacity="0.1"
                    />
                  </svg>

                  <svg
                    class="ellipse-two"
                    width="56"
                    height="56"
                    viewBox="0 0 56 56"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
