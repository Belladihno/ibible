
# Database
DATABASE_HOST=localhost
DATABASE_USERNAME=your-db-username
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=your-db-name
DATABASE_PORT=5432

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM_ADDRESS=noreply@rea.com
EMAIL_FROM_NAME=Rea Team

# App
API_VERSION=api/v1

#OAuth
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback


# GEMINI API_KEYS:
GEMINI_API_KEY=your-gemini-api-key
REFLECTION_GEMINI_API_KEY=your-reflection-gemini-api-key
GEMINI_MEMORIES_API_KEY=your-gemini-memories-api-key
PRAYER_GEMINI_API_KEY=your-prayer-gemini-api-key



#JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=3600s

FRONTEND_URL=http://google.com

POSTMAN_API_KEY=your_postman_api_key

# Bible API Configuration
BIBLE_API_BASE_URL=https://rest.api.bible/v1/
BIBLE_API_KEY=your-bible-api-key

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=your-bucket-name


# Sales service tools configuration
INSTANTLY_API_KEY=your-instantly-api-key
INSTANTLY_CAMPAIGN_ID=your-instantly-campaign-id
